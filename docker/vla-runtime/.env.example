# Copy this file to .env and use absolute host paths.
PC_DDS_IP=192.168.3.100
ROS_DOMAIN_ID=29

OPENPI_ROOT=/absolute/path/to/openpi
OPENPI_DATA_HOME=/absolute/path/to/.cache/openpi
OPENPI_CHECKPOINT_ROOT=/absolute/path/to/openpi_runs/checkpoints
OPENPI_CONFIG_NAME=pi05_armbot_lora
OPENPI_EXPERIMENT_PATH=pi05_armbot_lora/fixed-pick-41-v1/9999

GPU_DEVICE_ID=0
XLA_PYTHON_CLIENT_MEM_FRACTION=0.9
POLICY_PORT=8000
VLA_PROMPT=抓取药盒

# Keep true through DDS, image, state, inference and action-distribution checks.
VLA_SHADOW=true

