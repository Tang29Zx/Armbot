<?xml version="1.0"?>
<robot name="armbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================= -->
  <!-- Materials                                                          -->
  <!-- ================================================================= -->
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.4 0.8 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

  <!-- ================================================================= -->
  <!-- Macros for inertial (simplified box inertia)                       -->
  <!-- ================================================================= -->
  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}"
        iyy="${mass * (x*x + z*z) / 12.0}"
        izz="${mass * (x*x + y*y) / 12.0}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </xacro:macro>

  <!-- ================================================================= -->
  <!-- base_link — chassis center at ground level                         -->
  <!-- Mecanum chassis: approx 0.30m (L) x 0.26m (W) x 0.10m (H)        -->
  <!-- ================================================================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.26 0.10"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.26 0.10"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="5.0" x="0.30" y="0.26" z="0.10"/>
  </link>

  <!-- ================================================================= -->
  <!-- base_lidar_link — LiDAR mounting plate above chassis               -->
  <!-- ================================================================= -->
  <joint name="base_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_lidar_link"/>
    <origin xyz="0.175 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="base_lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <xacro:box_inertial mass="0.05" x="0.06" y="0.06" z="0.02"/>
  </link>

  <!-- ================================================================= -->
  <!-- laser — LiDAR scan frame                                           -->
  <!-- YDLIDAR typical: zero-angle points forward (+X), CCW rotation      -->
  <!-- 8-29: 曾误判雷达装反 180° 加 yaw=π 补偿，实测车头指示反向，撤销恢复 0 -->
  <!-- ================================================================= -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_lidar_link"/>
    <child link="laser"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.03"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <xacro:box_inertial mass="0.15" x="0.08" y="0.08" z="0.03"/>
  </link>

  <!-- ================================================================= -->
  <!-- arm_base_link — arm mounting point on chassis                      -->
  <!-- ================================================================= -->
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="0.05 0 0.10" rpy="0 0 0"/>
  </joint>

  <link name="arm_base_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.06"/>
      </geometry>
      <material name="red"/>
    </visual>
    <xacro:box_inertial mass="0.3" x="0.08" y="0.08" z="0.06"/>
  </link>

  <!-- ================================================================= -->
  <!-- Arm joints — published by action_pkg via /joint_states             -->
  <!-- Real transforms come from robot_state_publisher + /joint_states.   -->
  <!-- These joints define the kinematic chain for visualization.         -->
  <!-- ================================================================= -->

  <!-- joint_1_base -->
  <joint name="joint_1_base" type="revolute">
    <parent link="arm_base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" lower="-3.14159" upper="3.14159" velocity="3.0"/>
  </joint>
  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.08"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <xacro:box_inertial mass="0.2" x="0.08" y="0.08" z="0.08"/>
  </link>

  <!-- joint_2_shoulder -->
  <joint name="joint_2_shoulder" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-3.14159" upper="3.14159" velocity="3.0"/>
  </joint>
  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.12"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <xacro:box_inertial mass="0.25" x="0.04" y="0.04" z="0.12"/>
  </link>

  <!-- joint_3_elbow -->
  <joint name="joint_3_elbow" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-3.14159" upper="3.14159" velocity="3.0"/>
  </joint>
  <link name="link_3">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.10"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <xacro:box_inertial mass="0.2" x="0.04" y="0.04" z="0.10"/>
  </link>

  <!-- joint_4_wrist_pitch -->
  <joint name="joint_4_wrist_pitch" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="5" lower="-3.14159" upper="3.14159" velocity="3.0"/>
  </joint>
  <link name="link_4">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.06"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <xacro:box_inertial mass="0.1" x="0.06" y="0.06" z="0.06"/>
  </link>

  <!-- joint_5_wrist_roll -->
  <joint name="joint_5_wrist_roll" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="5" lower="-3.14159" upper="3.14159" velocity="3.0"/>
  </joint>
  <link name="link_5">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.04"/>
      </geometry>
      <material name="red"/>
    </visual>
    <xacro:box_inertial mass="0.05" x="0.05" y="0.05" z="0.04"/>
  </link>

  <!-- gripper -->
  <joint name="gripper" type="revolute">
    <parent link="link_5"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="3" lower="-0.785" upper="0.785" velocity="2.0"/>
  </joint>
  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.02 0.08"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <xacro:box_inertial mass="0.08" x="0.06" y="0.02" z="0.08"/>
  </link>

</robot>
