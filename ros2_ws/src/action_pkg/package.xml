<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>action_pkg</name>
  <version>0.0.0</version>
  <description>Arm/gripper control node implementing the stable ROS2 interface contract (docs/arm-control-interface.md)</description>
  <maintainer email="sunrise@todo.todo">sunrise</maintainer>
  <license>Apache-2.0</license>

  <test_depend>python3-pytest</test_depend>

  <!-- Runtime dependencies for the stable interface -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>action_interfaces</depend>

  <!-- NOTE: smbus2 is required at runtime for I2C. It is a PyPI package, not a
       ROS package, so install it in your workspace venv / system Python:
       pip install smbus2 -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
